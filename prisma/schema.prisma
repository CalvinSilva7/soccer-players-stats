generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  verified      Boolean   @default(false)
  verifyCode    String?
  codeExpiresAt DateTime?
  createdAt     DateTime  @default(now())
}